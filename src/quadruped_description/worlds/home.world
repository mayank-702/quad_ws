<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="home">

    <!-- ✅ KEEP DEFAULT PHYSICS -->
    <!-- <include>
      <uri>model://ground_plane</uri>
    </include> -->

    <model name="ground_custom">
  <static>true</static>
  <link name="link">
    <collision name="collision">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
          <size>100 100</size>
        </plane>
      </geometry>

      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>1.5</mu2>
          </ode>
        </friction>
      </surface>
    </collision>

    <visual name="visual">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
          <size>100 100</size>
        </plane>
      </geometry>
      <material>
        <ambient>0.6 0.4 0.2 1</ambient>
      </material>
    </visual>
  </link>
</model>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 🌤 Lighting -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.9 0.9 0.95 1</background>
    </scene>

    <!-- 🪵 Wooden Floor (VISUAL ONLY, NO COLLISION) -->
    <model name="wood_floor">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>10 10 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 🧱 WALLS (COLORED) -->

    <!-- Back Wall -->
    <model name="wall_back">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>10 0.1 2</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.9 1.0 1</ambient> <!-- light blue -->
          </material>
        </visual>
      </link>
      <pose>0 5 1 0 0 0</pose>
    </model>

    <!-- Front Wall -->
    <model name="wall_front">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>10 0.1 2</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.9 0.8 1</ambient> <!-- warm cream -->
          </material>
        </visual>
      </link>
      <pose>0 -5 1 0 0 0</pose>
    </model>

    <!-- Left Wall -->
    <model name="wall_left">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.1 10 2</size></box>
          </geometry>
          <material>
            <ambient>0.85 1.0 0.85 1</ambient> <!-- light green -->
          </material>
        </visual>
      </link>
      <pose>-5 0 1 0 0 0</pose>
    </model>

    <!-- Right Wall -->
    <model name="wall_right">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.1 10 2</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.85 0.9 1</ambient> <!-- light pink -->
          </material>
        </visual>
      </link>
      <pose>5 0 1 0 0 0</pose>
    </model>

    <!-- 🪑 TABLE -->
    <model name="table">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>1.2 0.8 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient> <!-- wood -->
          </material>
        </visual>
      </link>
      <pose>1.5 1 0.5 0 0 0</pose>
    </model>

    <!-- 🛋 SOFA -->
    <model name="sofa">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>1.5 0.6 0.6</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.4 0.8 1</ambient> <!-- blue -->
          </material>
        </visual>
      </link>
      <pose>-2 1 0.3 0 0 0</pose>
    </model>

    <!-- 📚 SHELF -->
    <model name="shelf">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.8 0.3 1.5</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.1 1</ambient>
          </material>
        </visual>
      </link>
      <pose>-3 -2 0.75 0 0 0</pose>
    </model>

  </world>
</sdf>
